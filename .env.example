# Copiá este archivo como ".env" (sin .example) y pegá tu clave. Sin comillas ni espacios.
# Sirven las claves nuevas (AQ.xxxx) y las viejas (AIzaxxxx).
GEMINI_API_KEY=PEGA_AQUI_TU_CLAVE
GEMINI_MODEL=gemini-flash-latest
# Modelo de imágenes para el "render realista" (opcional, experimental)
GEMINI_IMAGEN_MODELO=gemini-2.5-flash-image
# Nombre que aparece en el cuadro del plano
EMPRESA=Axis Ingeniería
